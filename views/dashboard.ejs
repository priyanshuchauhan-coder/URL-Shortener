<div class="container2-wrapper">
  <!-- <div class="container2" style="z-index: 2000;"> -->
<div class="dashboard-card">
  <div class="card-glow"></div>
  <div class="card-inner">
    <div class="card-header">
      <div class="card-title">
        <div class="icon-gradient">
          <svg viewBox="0 0 24 24" fill="none" stroke="white" width="16">
            <path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
        <h3>Performance Analytics</h3>
      </div>
      <span class="badge-live">● Live</span>
    </div>

    <div class="stats-grid">
      <div class="stat-block">
        <p>Total Views</p>
        <h4>24.5K</h4>
        <span class="positive">+12.3%</span>
      </div>
      <div class="stat-block">
        <p>Conversions</p>
        <h4>1.2K</h4>
        <span class="positive">+8.1%</span>
      </div>
    </div>

    <div class="bar-graph">
      <!-- Simple bar representation -->
      <div style="height: 40%" class="bar"><div style="height: 60%"></div></div>
      <div style="height: 60%" class="bar"><div style="height: 40%"></div></div>
      <div style="height: 75%" class="bar"><div style="height: 80%"></div></div>
      <div style="height: 45%" class="bar"><div style="height: 50%"></div></div>
      <div style="height: 85%" class="bar"><div style="height: 90%"></div></div>
      <div style="height: 65%" class="bar"><div style="height: 70%"></div></div>
      <div style="height: 95%" class="bar"><div style="height: 85%"></div></div>
    </div>
    <div class="url-check-section">
      <input
        type="text"
        placeholder="Enter short URL"
        class="url-input"
      />
      <button class="check-btn">Check Stats</button>
    
      <div class="url-result hidden">
          <p><strong>Mapped URL:</strong> <a class="mapped-url" href="#" target="_blank">--</a></p>
          <p><strong>Clicks:</strong> <span class="click-count">--</span></p>
          <p><strong>Created:</strong> <span class="created-time">--</span></p>
        </div>
    </div>
    
    <div class="card-footer">
      <span class="small-text">Last 7 days</span>
      <button class="details-btn">View Details →</button>
    </div>
  </div>
</div>
<!-- </div> -->
</div>